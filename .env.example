# Frontend environment (placeholders only - never commit real values).
# Copy to .env.local for local development.

# Base URL of the Spring Boot API. Leave as-is when using the Vite dev proxy
# (/api is forwarded to http://localhost:8080 by vite.config.ts).
VITE_API_BASE_URL=/api/v1

# Optional marketing links used across the site.
VITE_WHATSAPP_NUMBER=919740114246
VITE_PHONE_NUMBER=+919740114246

# NOTE: the admin password-reset emails link back to this app. The URL the
# backend uses is configured there, not here - see backend/.env.example
# (FRONTEND_BASE_URL, SMTP_USERNAME, SMTP_APP_PASSWORD, ADMIN_EMAIL).
