# Backend configuration example (placeholders only - never put real values here).
# Copy to backend/.env (gitignored) and fill in real values.
# In production (Render) set these as environment variables instead of a file.

# --- PostgreSQL -------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/bhuvana_nursery
DB_USERNAME=postgres
DB_PASSWORD=your-database-password
# Neon example (keep sslmode=require):
# DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require

# --- Initial administrator --------------------------------------------------
# Used by AdminUserInitializer ONLY while the admin_users table is empty.
# After the first boot the database is authoritative, so a password set
# through the reset flow survives restarts. This is not a default password.
ADMIN_USERNAME=nurseryadmin
ADMIN_PASSWORD=choose-a-strong-first-password
# Gmail address allowed to request password reset links.
ADMIN_EMAIL=your-admin-inbox@example.com

# --- Gmail SMTP (App Password, NOT the regular Gmail password) --------------
# Create one at https://myaccount.google.com/apppasswords (2-Step Verification
# must be enabled). Leave SMTP_HOST empty to disable email sending entirely.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
# Optional; defaults to SMTP_USERNAME when unset.
MAIL_FROM=your-gmail-address@gmail.com

# --- Public frontend URL ----------------------------------------------------
# The emailed reset link points here. APP_BASE_URL is the production name;
# FRONTEND_BASE_URL is accepted for older local setups.
APP_BASE_URL=http://localhost:5173
# FRONTEND_BASE_URL=http://localhost:5173

# --- Image storage ----------------------------------------------------------
# local = directory on this machine (development only; Render is ephemeral).
# r2    = Cloudflare R2 (required in production).
IMAGE_STORAGE=local
UPLOAD_DIRECTORY=./uploads

# Required when IMAGE_STORAGE=r2. Never expose the secret key to the frontend.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=bhuvana-nursery-images
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_PUBLIC_BASE_URL=https://images.example.com
# R2_REGION=auto

# --- Security / deployment --------------------------------------------------
# Local HTTP development: leave both defaults.
# HTTPS (production, or behind a trusted proxy): SECURE_COOKIES=true.
# Frontend on a different site than the API: COOKIE_SAME_SITE=None (HTTPS only).
SECURE_COOKIES=false
COOKIE_SAME_SITE=Lax
# true only when a trusted proxy overwrites X-Forwarded-For (Render/Netlify).
TRUST_FORWARDED_FOR=false
# Comma-separated exact origins, only for a split-origin deployment.
# Leave empty when using the recommended Netlify /api proxy.
CORS_ALLOWED_ORIGINS=

# --- Optional tuning --------------------------------------------------------
# DB_POOL_SIZE=5
# SESSION_TIMEOUT=8h
