# Production frontend environment (example only - no secrets).
#
# Recommended deployment uses the same-origin Netlify proxy configured in
# netlify.toml, so VITE_API_BASE_URL can stay at the default:
VITE_API_BASE_URL=/api/v1

# Alternative split-origin deployment (not recommended with cookies):
# VITE_API_BASE_URL=https://your-backend.onrender.com/api/v1
# On the backend you must then set:
#   CORS_ALLOWED_ORIGINS=https://your-site.netlify.app
#   COOKIE_SAME_SITE=None
#   SECURE_COOKIES=true
#
# Never put SMTP, database, R2 or admin credentials in any VITE_* variable:
# Vite inlines them into the public JavaScript bundle.

# Optional public marketing links (already defaulted in siteConfig.ts).
# VITE_WHATSAPP_NUMBER=919740114246
# VITE_PHONE_NUMBER=+919740114246
